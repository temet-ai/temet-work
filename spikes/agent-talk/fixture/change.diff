--- /dev/null
+++ b/crates/mike-mcp/src/schema_numbers_tests.rs
@@ -0,0 +1,17 @@
+use crate::tools::all_tools;
+
+/// Every numeric tool parameter states the type and limits the server accepts.
+#[test]
+fn numeric_parameters_match_what_the_server_accepts() {
+    let mut mismatches = Vec::new();
+    for tool in all_tools() {
+        for (name, schema) in tool.input_schema.properties() {
+            if schema.is_numeric() {
+                if let Err(why) = schema.matches_accepted(&tool.name, name) {
+                    mismatches.push(format!("{}.{name}: {why}", tool.name));
+                }
+            }
+        }
+    }
+    assert!(mismatches.is_empty(), "{}", mismatches.join("\n"));
+}
