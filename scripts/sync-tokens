#!/usr/bin/env node
// scripts/sync-tokens: writes crates/style/src/tokens.rs, and the faces in app/assets/fonts/, from
// the design system's token export, @temet-ai/design's dist/tokens.json.
//
//   scripts/sync-tokens [design-system-ui-folder]
//
// The folder is the design system's ui/ checkout: the argument, else TEMET_DESIGN_UI, else the
// "ui" entry of ~/.config/temet-design/config.json, the file its Storybook tools read. Build the
// export there first with `npm run build`.
//
// The values must come from a pushed commit of the design system. The script refuses a checkout
// with uncommitted changes, a commit that is on no remote branch, and a dist/tokens.json built
// from any commit other than the checkout's. Nothing in the design system changes.
//
// tokens.rs holds one `Tokens` value per theme (DARK, LIGHT) with a field per token, named after
// it, and each theme's measured component looks; then the status and stage maps, the part list,
// the tokens a user may change and the font files. Every theme must set the same tokens.
"use strict";

const { execFileSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const ROOT = path.join(__dirname, "..");
const OUT = path.join(ROOT, "crates", "style", "src", "tokens.rs");
const FONTS_OUT = path.join(ROOT, "app", "assets", "fonts");

// The tokens the design system documents (Theme/Colours, Theme/Type, Theme/Motion, the ramps
// table). Blueprint's other ramps stay out, and with them its turquoise, cerulean and sepia, which
// the Rules leave unused.
const KEEP = [
  /^--tm-/,
  /^--bp-palette-(blue|green|orange|red)-[1-6]$/,
  /^--bp-palette-(black|white)$/,
  /^--bp-palette-(dark-gray|gray|light-gray)-[1-5]$/,
  /^--bp-intent-/,
  /^--bp-typography-/,
  /^--bp-surface-/,
  /^--bp-emphasis-/,
];
// --tm-col-left and --tm-col-right switch between their -narrow, -medium and -wide values with the
// window's width. The app makes that choice itself from --tm-screen-medium and --tm-screen-wide.
const DROP = [/^--tm-col-(left|right)$/];

const STATES = { rest: "Rest", hover: "Hover", active: "Active", focus: "Focus", disabled: "Disabled" };
const INTENTS = { none: "None", primary: "Primary", success: "Success", warning: "Warning", danger: "Danger" };
const TYPES = {
  colour: "Rgba",
  px: "Px",
  duration: "Duration",
  curve: "Curve",
  number: "f32",
  font: "&'static [&'static str]",
  shadow: "&'static [Shadow]",
};
const LISTS = {
  colour: "colours",
  px: "sizes",
  duration: "durations",
  curve: "curves",
  number: "numbers",
  font: "fonts",
  shadow: "shadows",
};

function fail(message) {
  console.error(`sync-tokens: ${message}`);
  process.exit(1);
}

/** The design system's ui/ folder. */
function designUi() {
  const given = process.argv[2] || process.env.TEMET_DESIGN_UI;
  if (given) return path.resolve(given);
  const config = path.join(os.homedir(), ".config", "temet-design", "config.json");
  try {
    return JSON.parse(fs.readFileSync(config, "utf8")).ui;
  } catch {
    fail(`cannot find the design system's checkout: pass its ui/ folder, set TEMET_DESIGN_UI, or write {"ui": "<checkout>/ui"} to ${config}`);
  }
}

/** The export, once the checkout and the export are shown to come from pushed commits. */
function load(ui) {
  const git = (...args) => execFileSync("git", ["-C", ui, ...args], { encoding: "utf8" }).trim();
  const pushed = (commit) => git("branch", "-r", "--contains", commit) !== "";
  let head, dirty;
  try {
    head = git("rev-parse", "HEAD");
    dirty = git("status", "--porcelain", "--", ".");
  } catch (e) {
    fail(`cannot read the design system's checkout at ${ui}: ${e.message}`);
  }
  if (dirty) {
    const n = dirty.split("\n").length;
    fail(`${ui} has ${n} uncommitted change${n === 1 ? "" : "s"}; the tokens must come from a pushed commit, so ask its maintainers to commit and push`);
  }
  if (!pushed(head)) fail(`commit ${head.slice(0, 7)} of ${ui} is on no remote branch; ask its maintainers to push it`);
  const file = path.join(ui, "dist", "tokens.json");
  let data;
  try {
    data = JSON.parse(fs.readFileSync(file, "utf8"));
  } catch (e) {
    fail(`cannot read ${file} (${e.code || e.message}); run \`npm run build\` in ${ui}`);
  }
  if (data.commit !== head) {
    fail(`${file} was built from ${String(data.commit).slice(0, 7)}, but the checkout is at ${head.slice(0, 7)}; run \`npm run build\` in ${ui}`);
  }
  const measured = data.componentsCommit;
  let ancestor = true;
  try {
    git("merge-base", "--is-ancestor", measured, head);
  } catch {
    ancestor = false;
  }
  if (!ancestor || !pushed(measured)) fail(`the looks in ${file} were measured at ${measured}, which is not a pushed ancestor of ${head.slice(0, 7)}`);
  for (const key of ["version", "settings", "themes", "units", "fonts", "status", "stages", "parts", "components"]) {
    if (!(key in data)) fail(`${file} has no "${key}"`);
  }
  return { data, ui, from: `@temet-ai/design ${data.version}, commit ${head.slice(0, 7)} (looks measured at ${measured.slice(0, 7)})` };
}

// ---------- Values to Rust ----------

const fieldName = (token) => token.replace(/^--/, "").replace(/-/g, "_");
const float = (n) => (Number.isInteger(n) ? `${n}.0` : `${n}`);
const rgba = (hex) => {
  if (!/^#[0-9a-f]{8}$/.test(hex)) fail(`not a colour: ${hex}`);
  return `Rgba(0x${hex.slice(1)})`;
};
const colourDoc = (hex) => {
  const a = parseInt(hex.slice(7), 16);
  return `${hex.slice(0, 7)}${a === 255 ? "" : ` at ${Math.round((a / 255) * 100)}%`}`;
};
const shadow = (layers) =>
  `&[${layers
    .map((l) => `Shadow { inset: ${l.inset}, x: Px(${float(l.x)}), y: Px(${float(l.y)}), blur: Px(${float(l.blur)}), spread: Px(${float(l.spread)}), colour: ${rgba(l.color)} }`)
    .join(", ")}]`;

/** The export's unit for each token, as this script's kinds. */
const UNITS = { color: "colour", px: "px", ms: "duration", curve: "curve", number: "number", "font-stack": "font", shadow: "shadow" };

/** A token's value as Rust, by the unit the export gives it; null when the value does not fit it. */
function classify(name, value, unit) {
  const kind = UNITS[unit];
  if (!kind) fail(`${name} has a unit this script does not know: ${unit}`);
  const ok = {
    colour: typeof value === "string",
    px: typeof value === "number",
    duration: typeof value === "number",
    number: typeof value === "number",
    curve: Array.isArray(value) && value.length === 4 && value.every((v) => typeof v === "number"),
    font: Array.isArray(value) && value.every((v) => typeof v === "string"),
    shadow: Array.isArray(value) && value.every((v) => v && typeof v === "object"),
  }[kind];
  if (!ok) return null;
  switch (kind) {
    case "colour":
      return { kind, rust: rgba(value), doc: colourDoc(value) };
    case "px":
      return { kind, rust: `Px(${float(value)})`, doc: `${value}px` };
    case "duration":
      return { kind, rust: `Duration::from_millis(${Math.round(value)})`, doc: `${value}ms` };
    case "number":
      return { kind, rust: float(value), doc: `${value}` };
    case "curve":
      return { kind, rust: `Curve(${value.map(float).join(", ")})`, doc: `cubic-bezier(${value.join(", ")})` };
    case "font":
      return { kind, rust: `&[${value.map((f) => JSON.stringify(f)).join(", ")}]`, doc: value.join(", ") };
    default:
      return { kind, rust: shadow(value), doc: `${value.length} layer${value.length === 1 ? "" : "s"}` };
  }
}

/** One theme's tokens, classified and sorted by name. */
function tokensOf(theme, units) {
  const names = Object.keys(theme)
    .filter((n) => KEEP.some((re) => re.test(n)) && !DROP.some((re) => re.test(n)))
    .sort();
  return names.map((name) => {
    if (!(name in units)) fail(`${name} has no unit in the export's "units"`);
    const t = classify(name, theme[name], units[name]);
    if (!t) fail(`${name} is not a ${units[name]}: ${JSON.stringify(theme[name])}`);
    return { name, ...t };
  });
}

/** One theme's measured looks, in the export's order. */
function looksOf(components) {
  const out = [];
  for (const [component, variants] of Object.entries(components)) {
    for (const [variant, states] of Object.entries(variants)) {
      for (const [state, m] of Object.entries(states)) {
        if (!(state in STATES)) fail(`${component} ${variant} has a state this script does not know: ${state}`);
        const px4 = (a) => `[${a.map((v) => `Px(${float(v)})`).join(", ")}]`;
        out.push(
          `Look { component: ${JSON.stringify(component)}, variant: ${JSON.stringify(variant)}, state: State::${STATES[state]}, ` +
            `background: ${rgba(m.background)}, text: ${rgba(m.text)}, border: ${px4(m.border.width)}, ` +
            `border_colour: ${m.border.color ? `Some(${rgba(m.border.color)})` : "None"}, radius: Px(${float(m.radius)}), ` +
            `height: Px(${float(m.height)}), padding: ${px4(m.padding)}, font_size: Px(${float(m.fontSize)}), ` +
            `font_weight: ${float(m.fontWeight)}, shadow: ${shadow(m.shadow)} },`,
        );
      }
    }
  }
  return out;
}

function rust(data, from) {
  const names = Object.keys(data.themes);
  const per = Object.fromEntries(names.map((n) => [n, tokensOf(data.themes[n], data.units)]));
  const tokens = per[names[0]];
  // A theme is a full set of values for the same keys, each of the same kind.
  const shape = (list) => list.map((t) => `${t.name}:${t.kind}`);
  for (const n of names.slice(1)) {
    const a = new Set(shape(tokens));
    const b = new Set(shape(per[n]));
    const only = (x, y) => [...x].filter((k) => !y.has(k));
    if (only(a, b).length || only(b, a).length) {
      fail(`the ${names[0]} and ${n} themes differ: only in ${names[0]}: ${only(a, b).join(", ") || "none"}; only in ${n}: ${only(b, a).join(", ") || "none"}`);
    }
    if (!data.components[n]) fail(`no measured looks for the ${n} theme`);
  }
  const looks = Object.fromEntries(names.map((n) => [n, looksOf(data.components[n])]));

  const out = [];
  out.push(`//! The design system's tokens, from ${from}.`);
  out.push("//! Written by `scripts/sync-tokens` from the design system's dist/tokens.json; do not edit, run");
  out.push("//! the script again.");
  out.push("//!");
  out.push("//! A theme is one [`Tokens`] value with a field per token, named after it: `--tm-edge-quiet` is");
  out.push("//! `tm_edge_quiet`. Blueprint's ramp names hold other hues in the temet theme: blue holds the");
  out.push("//! accent (`--tm-accent-1` to `-6`), green holds blue (success) and orange holds yellow (warning).");
  out.push("//! Each value is the theme's default; the user's settings win over it, for the tokens in");
  out.push("//! [`SETTINGS`].");
  out.push("//!");
  out.push("//! A theme's `looks` are its parts as the design system's stories draw them, measured per");
  out.push("//! component, variant and state. A variant is named by the classes of the element and of its");
  out.push("//! part's root or nearest tm-* ancestor, sorted (`intent-primary minimal tm-row-end tm-status`),");
  out.push("//! with the sub-element first where a part has several (`th: default`).");
  out.push("");
  out.push("use std::time::Duration;");
  out.push("");
  out.push("use crate::{Curve, FontFile, Intent, Look, Px, Rgba, Shadow, StageView, State, StatusView};");
  out.push("");
  out.push("/// One theme: a value for every token, and its parts' measured looks.");
  out.push("#[derive(Clone, Copy, Debug, PartialEq)]");
  out.push("pub struct Tokens {");
  for (const t of tokens) {
    out.push(`    /// \`${t.name}\``);
    out.push(`    pub ${fieldName(t.name)}: ${TYPES[t.kind]},`);
  }
  out.push("    /// The parts' looks, by component, variant and state.");
  out.push("    pub looks: &'static [Look],");
  out.push("}");
  for (const n of names) {
    out.push("");
    out.push(`/// The ${n} theme.`);
    out.push(`pub const ${n.toUpperCase()}: Tokens = Tokens {`);
    for (const t of per[n]) out.push(`    ${fieldName(t.name)}: ${t.rust}, // ${t.doc.replace(/`/g, "")}`);
    out.push(`    looks: &${n.toUpperCase()}_LOOKS,`);
    out.push("};");
  }
  for (const n of names) {
    out.push("");
    out.push(`/// The ${n} theme's parts, as its stories draw them.`);
    out.push("#[rustfmt::skip]");
    out.push(`static ${n.toUpperCase()}_LOOKS: [Look; ${looks[n].length}] = [`);
    for (const l of looks[n]) out.push(`    ${l}`);
    out.push("];");
  }
  out.push("");
  out.push("/// Every theme, by name.");
  out.push(`pub const THEMES: [(&str, &Tokens); ${names.length}] = [${names.map((n) => `("${n}", &${n.toUpperCase()})`).join(", ")}];`);
  out.push("");
  out.push("impl Tokens {");
  for (const kind of Object.keys(LISTS)) {
    const of = tokens.filter((t) => t.kind === kind);
    out.push(`    /// Every ${kind === "px" ? "size" : kind} token, by name.`);
    out.push(`    pub fn ${LISTS[kind]}(&self) -> [(&'static str, ${TYPES[kind]}); ${of.length}] {`);
    out.push(`        [${of.map((t) => `("${t.name}", self.${fieldName(t.name)})`).join(", ")}]`);
    out.push("    }");
  }
  out.push("    /// A part's look in one variant and state, as the design system names them.");
  out.push("    pub fn look(&self, component: &str, variant: &str, state: State) -> Option<&'static Look> {");
  out.push("        self.looks");
  out.push("            .iter()");
  out.push("            .find(|l| l.component == component && l.variant == variant && l.state == state)");
  out.push("    }");
  out.push("}");
  out.push("");
  out.push("/// StatusTag's statuses, in the design system's order.");
  out.push(`pub const STATUS: [StatusView; ${data.status.length}] = [`);
  for (const s of data.status) {
    if (!(s.intent in INTENTS)) fail(`status ${s.name} has an intent this script does not know: ${s.intent}`);
    out.push(`    StatusView { name: "${s.name}", word: "${s.word}", icon: "${s.icon}", intent: Intent::${INTENTS[s.intent]} },`);
  }
  out.push("];");
  out.push("");
  out.push("/// StageTag's stages, in the order an issue goes through them.");
  out.push(`pub const STAGES: [StageView; ${data.stages.length}] = [`);
  for (const s of data.stages) out.push(`    StageView { name: "${s.name}", icon: "${s.icon}" },`);
  out.push("];");
  out.push("");
  out.push("/// The design system's parts and docs entries, as (id, name): the ids its docs tools take.");
  out.push(`pub const PARTS: [(&str, &str); ${data.parts.length}] = [`);
  for (const p of data.parts) out.push(`    (${JSON.stringify(p.id)}, ${JSON.stringify(p.name)}),`);
  out.push("];");
  out.push("");
  out.push("/// The tokens a person may override in temet-work's settings, the same in every theme.");
  out.push(`pub const SETTINGS: [&str; ${data.settings.length}] = [${data.settings.map((s) => JSON.stringify(s)).join(", ")}];`);
  const files = staticFonts(data);
  out.push("");
  out.push("/// The faces' font files the app embeds, under `app/assets/fonts/`, each with its licence.");
  out.push(`pub const FONTS: [FontFile; ${files.length}] = [`);
  for (const f of files) {
    out.push(`    FontFile { family: ${JSON.stringify(f.family)}, weight: ${float(f.weight)}, file: ${JSON.stringify(f.file)}, licence: ${JSON.stringify(f.licence)} },`);
  }
  out.push("];");
  return { text: out.join("\n") + "\n", count: tokens.length, looks: looks[names[0]].length, themes: names };
}

/** The static font files: a variable file repeats the weights the static ones give. */
function staticFonts(data) {
  const all = data.fonts.filter((f) => f.weight !== null);
  for (const f of data.fonts) {
    for (const p of [f.file, f.licence]) {
      if (!/^fonts\/[\w-]+\/[\w.\-[\],]+$/.test(p)) fail(`a font path the script will not copy: ${p}`);
    }
  }
  return all.map((f) => ({ ...f, file: f.file.replace(/^fonts\//, ""), licence: f.licence.replace(/^fonts\//, "") }));
}

/** Copies the static faces, their licences and source notes into app/assets/fonts/. */
function copyFonts(ui, data) {
  const dist = path.join(ui, "dist", "fonts");
  // NOTICE is temet-work's own account of the faces, not the design system's: keep it.
  const notice = path.join(FONTS_OUT, "NOTICE");
  const kept = fs.existsSync(notice) ? fs.readFileSync(notice) : null;
  fs.rmSync(FONTS_OUT, { recursive: true, force: true });
  if (kept) {
    fs.mkdirSync(FONTS_OUT, { recursive: true });
    fs.writeFileSync(notice, kept);
  }
  const dirs = new Set();
  for (const f of staticFonts(data)) {
    for (const p of [f.file, f.licence]) {
      const to = path.join(FONTS_OUT, p);
      fs.mkdirSync(path.dirname(to), { recursive: true });
      fs.copyFileSync(path.join(dist, p), to);
    }
    dirs.add(path.dirname(f.file));
  }
  for (const d of dirs) {
    const note = path.join(dist, d, "SOURCE.txt");
    if (!fs.existsSync(note)) fail(`${note} is missing: every face says where it came from`);
    fs.copyFileSync(note, path.join(FONTS_OUT, d, "SOURCE.txt"));
  }
  return dirs.size;
}

const { data, ui, from } = load(designUi());
const { text, count, looks, themes } = rust(data, from);
fs.writeFileSync(OUT, text);
try {
  execFileSync("rustfmt", ["--edition", "2024", OUT], { stdio: "inherit" });
} catch {
  fail(`wrote ${OUT} but rustfmt failed on it`);
}
const families = copyFonts(ui, data);
console.log(
  `sync-tokens: ${count} tokens and ${looks} looks in ${themes.length} themes (${themes.join(", ")}), ` +
    `${data.status.length} statuses, ${data.stages.length} stages, ${data.parts.length} parts, ${families} font families -> ` +
    `${path.relative(process.cwd(), OUT)}, ${path.relative(process.cwd(), FONTS_OUT)}`,
);
